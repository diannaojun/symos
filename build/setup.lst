     1                                  %include "config.inc"
     1                              <1> %define ADDR_SEG_MBR_PROG 0x07c0
     2                              <1> %define ADDR_SEG_SET_PROG 0x9f00
     3                              <1> %define ADDR_SEG_INI_PROG 0x9000
     4                              <1> %define ADDR_SEG_SYS_PROG 0x1000
     5                              <1> 
     6                              <1> %macro gdt_null 0
     7                              <1>     dw 0, 0
     8                              <1>     db 0
     9                              <1>     dw 0
    10                              <1>     db 0
    11                              <1> %endmacro
    12                              <1> 
    13                              <1> %macro gdt_segment 4
    14                              <1>     ; seg (base, limit, attribute, type)
    15                              <1>     dw ((%2) & 0xffff), ((%1) & 0xffff)
    16                              <1>     db ((%1) >> 16) & 0xff
    17                              <1>     dw (((%2) >> 8) & 0xf00) | ((%3) & 0xff) | (((%4) & 0xf) << 12)
    18                              <1>     db ((%1) >> 24) & 0xff
    19                              <1> %endmacro
    20                              <1> 
    21                              <1> ; program segment
    22                              <1> %define sta_prog_d          0x80     ; 数据段
    23                              <1> %define sta_prog_x          0x88     ; 可执行段
    24                              <1> %define sta_prog_xc         0x04     ; 符合要求的代码段(仅可执行)
    25                              <1> %define sta_prog_gd         0x04     ; 向下展开(不可执行的段), 栈
    26                              <1> %define sta_prog_xr         0x02     ; 可读(可执行段)
    27                              <1> %define sta_prog_wr         0x02     ; 可写(不可执行段)
    28                              <1> %define sta_prog_dt         0x01     ; 已访问(脏)
    29                              <1> ; program segment
    30                              <1> %define sta_sys_tss16       0x01     ; 可用的16位TSS
    31                              <1> %define sta_sys_ldt         0x02     ; 本地描述符表LDT
    32                              <1> %define sta_sys_tss16_buzy  0x03     ; 繁忙的16位TSS
    33                              <1> %define sta_sys_callgate16  0x04     ; 16位呼叫门
    34                              <1> %define sta_sys_taskgate    0x05     ; 任务门/Coum传输
    35                              <1> %define sta_sys_intgate16   0x06     ; 16位中断门
    36                              <1> %define sta_sys_trapgate16  0x07     ; 16位陷阱门
    37                              <1> %define sta_sys_tss32       0x09     ; 可用的32位TSS
    38                              <1> %define sta_sys_tss32_buzy  0x0b     ; 繁忙的32位TSS
    39                              <1> %define sta_sys_callgate32  0x0c     ; 32位调用门
    40                              <1> %define sta_sys_intgate32   0x0e     ; 32位中断门
    41                              <1> %define sta_sys_trapgate32  0x0f     ; 32位陷阱门
    42                              <1> ; other attribute
    43                              <1> %define sta_level0          0x00
    44                              <1> %define sta_level1          0x20
    45                              <1> %define sta_level2          0x40
    46                              <1> %define sta_level3          0x60
    47                              <1> %define sta_existent        0x10
    48                              <1> %define sta_non_existent    0x00
    49                              <1> ; other type
    50                              <1> %define stt_32def           0x04
    51                              <1> %define stt_32c16           0x00
    52                              <1> %define stt_64def           0x02
    53                              <1> %define stt_val             0x01
    54                              <1> %define stt_limitalign4kb   0x08
    55                              <1> 
    56                              <1> ; MBR struction
    57                              <1> %macro mbr_null 0
    58                              <1>     db 0x00, 0x00
    59                              <1>     dw 0x02
    60                              <1>     db 0x5b, 0xff
    61                              <1>     dw 0xffff
    62                              <1>     dd 0x00000001
    63                              <1>     dd 0xffffffff
    64                              <1> %endmacro
     2                                  org ADDR_SEG_SET_PROG << 4
     3                                  bits 16
     4                                  
     5                                  ; ------ 00500
     6                                  ; STACK
     7                                  ; ------ 08000
     8                                  
     9 00000000 EB00                    jmp _start
    10                                  
    11                                  _start:
    12 00000002 31C0                        xor ax, ax
    13 00000004 8ED8                        mov ds, ax
    14 00000006 FA                          cli
    15                                  setA20e:
    16 00000007 E83400                      call wait8064
    17 0000000A B0D1                        mov al, 0xd1
    18 0000000C E664                        out 0x64, al
    19 0000000E E82D00                      call wait8064
    20 00000011 B0DF                        mov al, 0xdf
    21 00000013 E660                        out 0x60, al
    22 00000015 E82600                      call wait8064
    23 00000018 E492                        in al, 0x92
    24 0000001A 0C02                        or al, 0x02
    25 0000001C E692                        out 0x92, al
    26                                  setXDT:
    27 0000001E 3E0F0116487C                lgdt [ds:0x7c48]
    28 00000024 3E0F011E4E7C                lidt [ds:0x7c4e]
    29                                  setCR0PE:
    30 0000002A 87DB                        xchg bx, bx
    31 0000002C 0F20C0                      mov eax, cr0
    32 0000002F 6683C801                    or eax, 0x00000001
    33 00000033 0F22C0                      mov cr0, eax
    34 00000036 66EA[60000000]0800          jmp dword 0x0008:mode32
    35                                  wait8064:
    36 0000003E E464                        in al, 0x64
    37 00000040 A802                        test al, 0x02
    38 00000042 75FA                        jnz wait8064
    39 00000044 C3                          ret
    40                                  
    41                                  bits 32
    42 00000045 90<rep 1Bh>             align 32
    43                                  mode32:
    44 00000060 66B81000                    mov ax, 0x0010
    45 00000064 8ED8                        mov ds, ax
    46 00000066 8EC0                        mov es, ax
    47 00000068 8EE0                        mov fs, ax
    48 0000006A 8EE8                        mov gs, ax
    49 0000006C 66B81800                    mov ax, 0x0018
    50 00000070 8ED0                        mov ss, ax
    51 00000072 BC007B0000                  mov esp, 0x08000 - 0x00500
    52 00000077 89E5                        mov ebp, esp
    53 00000079 31FF                        xor edi, edi
    54 0000007B 31F6                        xor esi, esi
    55                                  test_print:
    56 0000007D F4                          hlt
    57 0000007E EBFE                        jmp $
    58                                  
    59 00000080 00<rep F80h>            times 4096 -($ - $$) db 0
