     1                                  %include "config.inc"
     1                              <1> %define ADDR_SEG_MBR_PROG 0x07c0
     2                              <1> %define ADDR_SEG_SET_PROG 0x9f00
     3                              <1> %define ADDR_SEG_INI_PROG 0x9000
     4                              <1> %define ADDR_SEG_SYS_PROG 0x1000
     5                              <1> 
     6                              <1> %macro gdt_null 0
     7                              <1>     dw 0, 0
     8                              <1>     db 0
     9                              <1>     dw 0
    10                              <1>     db 0
    11                              <1> %endmacro
    12                              <1> 
    13                              <1> %macro gdt_segment 4
    14                              <1>     ; seg (base, limit, attribute, type)
    15                              <1>     dw ((%2) & 0xffff), ((%1) & 0xffff)
    16                              <1>     db ((%1) >> 16) & 0xff
    17                              <1>     dw (((%2) >> 8) & 0xf00) | ((%3) & 0xff) | (((%4) & 0xf) << 12)
    18                              <1>     db ((%1) >> 24) & 0xff
    19                              <1> %endmacro
    20                              <1> 
    21                              <1> ; program segment
    22                              <1> %define sta_prog_d          0x80     ; 数据段
    23                              <1> %define sta_prog_x          0x88     ; 可执行段
    24                              <1> %define sta_prog_xc         0x04     ; 符合要求的代码段(仅可执行)
    25                              <1> %define sta_prog_gd         0x04     ; 向下展开(不可执行的段), 栈
    26                              <1> %define sta_prog_xr         0x02     ; 可读(可执行段)
    27                              <1> %define sta_prog_wr         0x02     ; 可写(不可执行段)
    28                              <1> %define sta_prog_dt         0x01     ; 已访问(脏)
    29                              <1> ; program segment
    30                              <1> %define sta_sys_tss16       0x01     ; 可用的16位TSS
    31                              <1> %define sta_sys_ldt         0x02     ; 本地描述符表LDT
    32                              <1> %define sta_sys_tss16_buzy  0x03     ; 繁忙的16位TSS
    33                              <1> %define sta_sys_callgate16  0x04     ; 16位呼叫门
    34                              <1> %define sta_sys_taskgate    0x05     ; 任务门/Coum传输
    35                              <1> %define sta_sys_intgate16   0x06     ; 16位中断门
    36                              <1> %define sta_sys_trapgate16  0x07     ; 16位陷阱门
    37                              <1> %define sta_sys_tss32       0x09     ; 可用的32位TSS
    38                              <1> %define sta_sys_tss32_buzy  0x0b     ; 繁忙的32位TSS
    39                              <1> %define sta_sys_callgate32  0x0c     ; 32位调用门
    40                              <1> %define sta_sys_intgate32   0x0e     ; 32位中断门
    41                              <1> %define sta_sys_trapgate32  0x0f     ; 32位陷阱门
    42                              <1> ; other attribute
    43                              <1> %define sta_level0          0x00
    44                              <1> %define sta_level1          0x20
    45                              <1> %define sta_level2          0x40
    46                              <1> %define sta_level3          0x60
    47                              <1> %define sta_existent        0x10
    48                              <1> %define sta_non_existent    0x00
    49                              <1> ; other type
    50                              <1> %define stt_32def           0x04
    51                              <1> %define stt_32c16           0x00
    52                              <1> %define stt_64def           0x02
    53                              <1> %define stt_val             0x01
    54                              <1> %define stt_limitalign4kb   0x08
    55                              <1> 
    56                              <1> ; MBR struction
    57                              <1> %macro mbr_null 0
    58                              <1>     db 0x00, 0x00
    59                              <1>     dw 0x02
    60                              <1>     db 0x5b, 0xff
    61                              <1>     dw 0xffff
    62                              <1>     dd 0x00000001
    63                              <1>     dd 0xffffffff
    64                              <1> %endmacro
     2                                  org ADDR_SEG_SET_PROG << 4
     3                                  bits 16
     4                                  
     5                                  ; ------ 00500
     6                                  ; STACK
     7                                  ; ------ 08000
     8                                  
     9 00000000 EB2C                    jmp _start
    10                                  
    11                                  gdt:
    12                                      .null   gdt_null
    12                              <1>  .null :
     7 00000002 00000000            <1>  dw 0, 0
     8 00000006 00                  <1>  db 0
     9 00000007 0000                <1>  dw 0
    10 00000009 00                  <1>  db 0
    13                                      .code   gdt_segment 0x00000000, 0xffffffff, sta_prog_x | sta_prog_xr, stt_32def | stt_limitalign4kb
    13                              <1>  .code :
    14                              <1> 
    15 0000000A FFFF0000            <1>  dw ((%2) & 0xffff), ((%1) & 0xffff)
    16 0000000E 00                  <1>  db ((%1) >> 16) & 0xff
    17 0000000F 8ACF                <1>  dw (((%2) >> 8) & 0xf00) | ((%3) & 0xff) | (((%4) & 0xf) << 12)
    18 00000011 00                  <1>  db ((%1) >> 24) & 0xff
    14                                      .data   gdt_segment 0x00000000, 0xffffffff, sta_prog_d | sta_prog_wr, stt_32def | stt_limitalign4kb
    14                              <1>  .data :
    14                              <1> 
    15 00000012 FFFF0000            <1>  dw ((%2) & 0xffff), ((%1) & 0xffff)
    16 00000016 00                  <1>  db ((%1) >> 16) & 0xff
    17 00000017 82CF                <1>  dw (((%2) >> 8) & 0xf00) | ((%3) & 0xff) | (((%4) & 0xf) << 12)
    18 00000019 00                  <1>  db ((%1) >> 24) & 0xff
    15                                      .stack  gdt_segment 0x00008000, 0x08000 - 0x00500, sta_prog_d | sta_prog_wr | sta_prog_gd, stt_32def
    15                              <1>  .stack :
    14                              <1> 
    15 0000001A 007B0080            <1>  dw ((%2) & 0xffff), ((%1) & 0xffff)
    16 0000001E 00                  <1>  db ((%1) >> 16) & 0xff
    17 0000001F 8640                <1>  dw (((%2) >> 8) & 0xf00) | ((%3) & 0xff) | (((%4) & 0xf) << 12)
    18 00000021 00                  <1>  db ((%1) >> 24) & 0xff
    16                                      .end:
    17                                  gdt_info:
    18 00000022 2000                        dw gdt.end - gdt
    19 00000024 [02000000]                  dd gdt
    20                                  idt_info:
    21 00000028 0000<rep 3h>                times 3 dw 0
    22                                  
    23                                  _start:
    24                                  mode16:
    25 0000002E 8CC8                        mov ax, cs
    26 00000030 8ED8                        mov ds, ax
    27 00000032 3E0F0116[2200]              lgdt [ds:gdt_info]
    28 00000038 3E0F011E[2200]              lidt [ds:gdt_info]
    29 0000003E E492                        in al, 0x92
    30 00000040 0C02                        or al, 0x02
    31 00000042 E692                        out 0x92, al
    32 00000044 FA                          cli
    33 00000045 0F20C0                      mov eax, cr0
    34 00000048 6683C801                    or eax, 0x00000001
    35 0000004C 0F22C0                      mov cr0, eax
    36 0000004F 66EA[60000000]0800          jmp dword 0x0008:mode32
    37                                  
    38                                  bits 32
    39 00000057 90<rep 9h>              align 32
    40                                  mode32:
    41 00000060 66B81000                    mov ax, 0x0010
    42 00000064 8ED8                        mov ds, ax
    43 00000066 8EC0                        mov es, ax
    44 00000068 8EE0                        mov fs, ax
    45 0000006A 8EE8                        mov gs, ax
    46 0000006C 66B81800                    mov ax, 0x0018
    47 00000070 8ED0                        mov ss, ax
    48 00000072 BC007B0000                  mov esp, 0x08000 - 0x00500
    49 00000077 89E5                        mov ebp, esp
    50 00000079 31FF                        xor edi, edi
    51 0000007B 31F6                        xor esi, esi
    52                                  test_print:
    53 0000007D F4                          hlt
    54 0000007E EBFE                        jmp $
    55                                  
    56 00000080 00<rep F80h>            times 4096 -($ - $$) db 0
