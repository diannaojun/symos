     1                                  %include "config.inc"
     1                              <1> %define DATA_LEN_OF_SETUP 3
     2                              <1> %define ADDR_SEG_MBR_PROG 0x07c0
     3                              <1> %define ADDR_SEG_SET_PROG 0x9f00
     4                              <1> %define ADDR_SEG_INI_PROG 0x9000
     5                              <1> %define ADDR_SEG_SYS_PROG 0x1000
     6                              <1> 
     7                              <1> %macro gdt_null 0
     8                              <1>     dw 0, 0
     9                              <1>     db 0
    10                              <1>     dw 0
    11                              <1>     db 0
    12                              <1> %endmacro
    13                              <1> 
    14                              <1> %macro gdt_segment 4
    15                              <1>     ; seg (base, limit, attribute, type)
    16                              <1>     dw ((%2) & 0xffff), ((%1) & 0xffff)
    17                              <1>     db ((%1) >> 16) & 0xff
    18                              <1>     dw (((%2) >> 8) & 0xf00) | ((%3) & 0xff) | (((%4) & 0xf) << 12)
    19                              <1>     db ((%1) >> 24) & 0xff
    20                              <1> %endmacro
    21                              <1> 
    22                              <1> ; program segment
    23                              <1> %define sta_prog_d          0x80     ; 数据段
    24                              <1> %define sta_prog_x          0x88     ; 可执行段
    25                              <1> %define sta_prog_xc         0x04     ; 符合要求的代码段(仅可执行)
    26                              <1> %define sta_prog_gd         0x04     ; 向下展开(不可执行的段), 栈
    27                              <1> %define sta_prog_xr         0x02     ; 可读(可执行段)
    28                              <1> %define sta_prog_wr         0x02     ; 可写(不可执行段)
    29                              <1> %define sta_prog_dt         0x01     ; 已访问(脏)
    30                              <1> ; program segment
    31                              <1> %define sta_sys_tss16       0x01     ; 可用的16位TSS
    32                              <1> %define sta_sys_ldt         0x02     ; 本地描述符表LDT
    33                              <1> %define sta_sys_tss16_buzy  0x03     ; 繁忙的16位TSS
    34                              <1> %define sta_sys_callgate16  0x04     ; 16位呼叫门
    35                              <1> %define sta_sys_taskgate    0x05     ; 任务门/Coum传输
    36                              <1> %define sta_sys_intgate16   0x06     ; 16位中断门
    37                              <1> %define sta_sys_trapgate16  0x07     ; 16位陷阱门
    38                              <1> %define sta_sys_tss32       0x09     ; 可用的32位TSS
    39                              <1> %define sta_sys_tss32_buzy  0x0b     ; 繁忙的32位TSS
    40                              <1> %define sta_sys_callgate32  0x0c     ; 32位调用门
    41                              <1> %define sta_sys_intgate32   0x0e     ; 32位中断门
    42                              <1> %define sta_sys_trapgate32  0x0f     ; 32位陷阱门
    43                              <1> ; other attribute
    44                              <1> %define sta_level0          0x00
    45                              <1> %define sta_level1          0x20
    46                              <1> %define sta_level2          0x40
    47                              <1> %define sta_level3          0x60
    48                              <1> %define sta_existent        0x10
    49                              <1> %define sta_non_existent    0x00
    50                              <1> ; other type
    51                              <1> %define stt_32def           0x04
    52                              <1> %define stt_32c16           0x00
    53                              <1> %define stt_64def           0x02
    54                              <1> %define stt_val             0x01
    55                              <1> %define stt_limitalign4kb   0x08
    56                              <1> 
    57                              <1> ; MBR struction
    58                              <1> %macro mbr_null 0
    59                              <1>     db 0x00, 0x00
    60                              <1>     dw 0x02
    61                              <1>     db 0x5b, 0xff
    62                              <1>     dw 0xffff
    63                              <1>     dd 0x00000001
    64                              <1>     dd 0xffffffff
    65                              <1> %endmacro
     2                                  
     3                                  org ADDR_SEG_SET_PROG << 4
     4                                  bits 16
     5                                  
     6 00000000 EB0E                    jmp _start
     7                                  
     8                                  ; ------ 00500
     9                                  ; STACK
    10                                  ; ------ 08000
    11                                  
    12                                  
    13                                  
    14                                  
    15 00000002 90<rep Eh>              align 16
    16                                  _start:
    17                                  mode16:
    18 00000010 FA                          cli
    19                                  
    20 00000011 E492                        in al, 0x92
    21 00000013 0C02                        or al, 0x02
    22 00000015 E692                        out 0x92, al
    23                                  
    24 00000017 0F0116507D                  lgdt [0x7d50]
    25 0000001C 0F011E567D                  lidt [0x7d56]
    26                                  
    27 00000021 0F20C0                      mov eax, cr0
    28 00000024 6683C801                    or eax, 0x00000001
    29 00000028 0F22C0                      mov cr0, eax
    30                                  
    31 0000002B 66EA[40000000]0800          jmp dword 0x0008:mode32
    32                                  
    33                                  bits 32
    34 00000033 90<rep Dh>              align 32
    35                                  mode32:
    36 00000040 66B81000                    mov ax, 0x0010
    37 00000044 8ED8                        mov ds, ax
    38 00000046 8EC0                        mov es, ax
    39 00000048 8EE0                        mov fs, ax
    40 0000004A 8EE8                        mov gs, ax
    41 0000004C 66B81800                    mov ax, 0x0018
    42 00000050 8ED0                        mov ss, ax
    43 00000052 BC007B0000                  mov esp, 0x08000 - 0x00500
    44 00000057 89E5                        mov ebp, esp
    45 00000059 31FF                        xor edi, edi
    46 0000005B 31F6                        xor esi, esi
    47                                  test_print:
    48 0000005D F4                          hlt
    49 0000005E EBFE                        jmp $
    50                                  
    51 00000060 00<rep FA0h>            times 4096 -($ - $$) db 0
